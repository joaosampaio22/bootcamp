generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Estrutura mínima da Etapa 0; autenticação e sessões são implementadas na Etapa 1.
model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  emailNormalized String   @unique @db.VarChar(254)
  passwordHash    String   @db.Text
  timeZone        String   @default("America/Sao_Paulo") @db.VarChar(80)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  sessions        AuthSession[]
  subjects        Subject[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model Subject {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  name           String    @db.VarChar(80)
  normalizedName String    @db.VarChar(160)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, archivedAt])
}
