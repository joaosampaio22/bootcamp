generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Estrutura mínima da Etapa 0; autenticação e sessões são implementadas na Etapa 1.
model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  emailNormalized String   @unique @db.VarChar(254)
  passwordHash    String   @db.Text
  timeZone        String   @default("America/Sao_Paulo") @db.VarChar(80)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  sessions        AuthSession[]
  subjects        Subject[]
  focusSessions   FocusSession[]
  rewardEvents    RewardEvent[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model Subject {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  name           String    @db.VarChar(80)
  normalizedName String    @db.VarChar(160)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  focusSessions  FocusSession[]

  @@index([userId, archivedAt])
}

enum FocusStatus {
  RUNNING
  PAUSED
  NEEDS_RECONCILIATION
  COMPLETED
  INTERRUPTED
  DISCARDED
}

enum RewardSource {
  FOCUS_SESSION
  REVIEW_ATTEMPT
}

model FocusSession {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  subjectId            String?     @db.Uuid
  contentId            String?     @db.Uuid
  plannedSeconds       Int
  activeSeconds        Int         @default(0)
  elapsedActiveSeconds Int         @default(0)
  status               FocusStatus @default(RUNNING)
  activeStartedAt      DateTime?   @db.Timestamptz(3)
  startedAt            DateTime    @db.Timestamptz(3)
  finishedAt           DateTime?   @db.Timestamptz(3)
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject              Subject?    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  transitions          FocusTransition[]
  actions              FocusAction[]

  @@unique([id, userId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
}

model FocusTransition {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  sessionId     String      @db.Uuid
  fromStatus    FocusStatus?
  toStatus      FocusStatus
  activeSeconds Int
  createdAt     DateTime    @db.Timestamptz(3)
  session       FocusSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, sessionId, createdAt])
}

model FocusAction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  sessionId   String   @db.Uuid
  key         String   @db.Uuid
  fingerprint String   @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  session     FocusSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, key])
}

model RewardEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  sourceType RewardSource
  sourceId   String       @db.Uuid
  xp         Int
  localDate  DateTime     @db.Date
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([userId, localDate, sourceType])
}
