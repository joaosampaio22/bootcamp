# Apenas exemplos. npm run setup:env gera senhas aleatórias para uso local.
POSTGRES_USER=estudo
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_DB=estudo_em_dia
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://estudo:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/estudo_em_dia?schema=public
TEST_DATABASE_URL=postgresql://estudo:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5433/estudo_em_dia_test?schema=public
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
PORT=3000
NODE_ENV=development
